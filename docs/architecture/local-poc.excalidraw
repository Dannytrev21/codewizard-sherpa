      "isDeleted": false,
      "boundElements": [],
      "updated": 1778604375968,
      "link": null,
      "locked": false,
      "text": "Step 4 — Make the change\nApply the recipe — for example,\nupgrade the vulnerable package\n— to produce the actual code\nchange.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 10,
      "containerId": "e-box12",
      "originalText": "Step 4 — Make the change\nApply the recipe — for example,\nupgrade the vulnerable package\n— to produce the actual code\nchange.",
      "lineHeight": 1.25
    },
