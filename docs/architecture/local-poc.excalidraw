      "updated": 1778604375968,
      "link": null,
      "locked": false,
      "text": "Step 3 — Plan the fix\nLook the vulnerability up in a\nlocal database built from public\nvulnerability databases (NVD,\nGHSA, OSV), then choose a\ndeterministic fix recipe.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 10,
      "containerId": "e-box11",
      "originalText": "Step 3 — Plan the fix\nLook the vulnerability up in a\nlocal database built from public\nvulnerability databases (NVD,\nGHSA, OSV), then choose a\ndeterministic fix recipe.",
      "lineHeight": 1.25
    },
