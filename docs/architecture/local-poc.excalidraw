      "link": null,
      "locked": false,
      "text": "Step 5 — Validate\nBuild and test the patched code\ninside a locked-down sandbox\nthat cannot reach the network\nor the rest of the machine.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 10,
      "containerId": "e-box13",
      "originalText": "Step 5 — Validate\nBuild and test the patched code\ninside a locked-down sandbox\nthat cannot reach the network\nor the rest of the machine.",
