;; codegenie macOS sandbox profile — Phase 3 / S4-03 (ADR-0006 §Decision).
;;
;; Loaded via ``importlib.resources`` and rendered through
;; ``string.Template.safe_substitute`` by
;; ``codegenie.transforms.sandbox.sandbox_exec._render_profile``. Placeholder
;; tokens: JAIL (the absolute path of the jail cwd) and ALLOWLIST_HOSTS
;; (zero or more (allow network*) clauses rendered from the NetworkPolicy
;; sum). Any other dollar-prefixed token surviving substitute raises
;; ProfilePlaceholderUnresolved (AC-28) — Rule 12: fail loud.
(version 1)
(deny default)

;; Read access for dyld shared cache, frameworks, and system binaries.
;; ``(literal "/")`` is required for dyld's root-directory stat on macOS 14+;
;; ``/System`` and ``/private`` are required for the shared cache and
;; ``/etc → /private/etc`` symlink targets respectively.
(allow file-read*
  (literal "/")
  (subpath "/usr/lib")
  (subpath "/usr/bin")
  (subpath "/usr/local/bin")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/Library/Developer/CommandLineTools")
  (subpath "/System")
  (subpath "/private"))

;; Read + write inside the jail directory.
(allow file-read* file-write*
  (subpath "$JAIL"))

;; /private/tmp is the canonical /tmp on macOS; npm uses it for scratch.
(allow file-read* file-write*
  (subpath "/private/tmp"))

;; Process invocation (npm shells out to node + helper binaries).
(allow process-exec
  (subpath "/usr/local/bin")
  (subpath "/usr/bin")
  (subpath "/bin")
  (subpath "/sbin"))

;; Network policy — body substituted per ``NetworkPolicy``.
;; ``DenyAll`` renders an empty body so no (allow network*) clause exists.
;; ``RegistryAllowlist`` renders one (allow network* (remote tcp "*:PORT"))
;; per unique port in the URL set — SBPL accepts only ``*`` or ``localhost``
;; inside ``(remote tcp ...)``, so hostname filtering is NOT enforced here.
;; Per ADR-0006 §Consequences, macOS hostname allowlisting is owned by pf
;; rules at the parent process layer (Phase 5 substitutes the substrate
;; entirely with Lima/DinD).
$ALLOWLIST_HOSTS

;; Required syscall surface — minimal.
(allow mach-lookup)
(allow sysctl-read)
(allow process-fork)
(allow signal (target self))
