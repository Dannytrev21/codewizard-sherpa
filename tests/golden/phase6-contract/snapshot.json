{
  "all": [
    "AwaitingHumanReview",
    "Completed",
    "FailedUnrecoverable",
    "GateFailedRetryable",
    "LedgerStateKind",
    "NeedsPlan",
    "PatchApplied",
    "PlanReady",
    "SutDigest",
    "TransitionEvent",
    "TransitionId",
    "VulnLedgerState",
    "VulnRemediationCase",
    "VulnRemediationResult",
    "VulnRemediationSut"
  ],
  "case_schema": {
    "additionalProperties": false,
    "description": "Frozen Pydantic model \u2014 the bench harness hands one of these per case.",
    "properties": {
      "case_id": {
        "title": "Case Id",
        "type": "string"
      },
      "cassette_id": {
        "title": "Cassette Id",
        "type": "string"
      },
      "cve": {
        "title": "Cve",
        "type": "string"
      },
      "execution_mode": {
        "enum": [
          "dry_run",
          "apply",
          "replay"
        ],
        "title": "Execution Mode",
        "type": "string"
      },
      "repo_fixture": {
        "title": "Repo Fixture",
        "type": "string"
      }
    },
    "required": [
      "case_id",
      "repo_fixture",
      "cve",
      "cassette_id",
      "execution_mode"
    ],
    "title": "VulnRemediationCase",
    "type": "object"
  },
  "checkpoint_sqlite_schema": "CREATE TABLE IF NOT EXISTS checkpoint_chain (\n    sequence       INTEGER PRIMARY KEY AUTOINCREMENT,\n    transition_id  TEXT    NOT NULL UNIQUE,\n    prior_head     TEXT    NOT NULL,\n    next_head      TEXT    NOT NULL,\n    event_bytes    BLOB    NOT NULL,\n    written_at     TEXT    NOT NULL\n);\nCREATE UNIQUE INDEX IF NOT EXISTS ix_chain_next_head ON checkpoint_chain(next_head);\n",
  "checkpoint_store_is_runtime_protocol": true,
  "checkpoint_store_protocol": {
    "append": {
      "is_coroutine_function": false,
      "signature": "(self, event: 'TransitionEvent') -> 'ChainHead'"
    },
    "close": {
      "is_coroutine_function": false,
      "signature": "(self) -> 'None'"
    },
    "lock": {
      "is_coroutine_function": false,
      "signature": "(self, workflow_id: 'WorkflowId') -> 'AbstractContextManager[None]'"
    },
    "read_all_for_workflow": {
      "is_coroutine_function": false,
      "signature": "(self, workflow_id: 'WorkflowId') -> 'Iterator[TransitionEvent]'"
    },
    "tail_chain_head": {
      "is_coroutine_function": false,
      "signature": "(self, workflow_id: 'WorkflowId') -> 'ChainHead'"
    }
  },
  "is_runtime_protocol": true,
  "ledger_state_schema": {
    "$defs": {
      "AwaitingHumanReview": {
        "additionalProperties": false,
        "description": "Terminal: handed off to a human reviewer. ``handoff_path`` is the\nrelative path into the per-run artifact directory (``None`` if the\norchestrator could not allocate before the handoff).",
        "properties": {
          "handoff_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Handoff Path"
          },
          "kind": {
            "const": "awaiting_human_review",
            "default": "awaiting_human_review",
            "title": "Kind",
            "type": "string"
          },
          "review_reason": {
            "enum": [
              "no_concrete_match",
              "trust_outcome_failed",
              "policy_violation_unrecoverable",
              "MULTI_PACKAGE_CVE"
            ],
            "title": "Review Reason",
            "type": "string"
          }
        },
        "required": [
          "review_reason"
        ],
        "title": "AwaitingHumanReview",
        "type": "object"
      },
      "Completed": {
        "additionalProperties": false,
        "description": "Terminal: remediation finished. ``report_path`` is the relative path\ninto the per-run artifact directory (``None`` when the orchestrator\nfailed to allocate the report file before completion).",
        "properties": {
          "kind": {
            "const": "completed",
            "default": "completed",
            "title": "Kind",
            "type": "string"
          },
          "report_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Report Path"
          }
        },
        "title": "Completed",
        "type": "object"
      },
      "FailedUnrecoverable": {
        "additionalProperties": false,
        "description": "Terminal: an unrecoverable failure. ``reason`` is the closed-set\nfailure-mode key from ``phase-arch-design.md \u00a7\"Failure modes\"``.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/$defs/RemediationError"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "kind": {
            "const": "failed_unrecoverable",
            "default": "failed_unrecoverable",
            "title": "Kind",
            "type": "string"
          },
          "reason": {
            "enum": [
              "checkpoint_integrity",
              "subgraph_aborted",
              "manifest_rejected",
              "policy_violation",
              "internal_invariant_violated"
            ],
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "FailedUnrecoverable",
        "type": "object"
      },
      "GateFailedRetryable": {
        "additionalProperties": false,
        "description": "One or more gates failed but the failure mode admits retry.",
        "properties": {
          "attempt_number": {
            "title": "Attempt Number",
            "type": "integer"
          },
          "failing_signals": {
            "items": {
              "type": "string"
            },
            "title": "Failing Signals",
            "type": "array"
          },
          "kind": {
            "const": "gate_failed_retryable",
            "default": "gate_failed_retryable",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "failing_signals",
          "attempt_number"
        ],
        "title": "GateFailedRetryable",
        "type": "object"
      },
      "NeedsPlan": {
        "additionalProperties": false,
        "description": "Initial state \u2014 no plan has been proposed yet. No evidence payload.",
        "properties": {
          "kind": {
            "const": "needs_plan",
            "default": "needs_plan",
            "title": "Kind",
            "type": "string"
          }
        },
        "title": "NeedsPlan",
        "type": "object"
      },
      "PatchApplied": {
        "additionalProperties": false,
        "description": "The proposed patch has been applied; gates are pending.",
        "properties": {
          "kind": {
            "const": "patch_applied",
            "default": "patch_applied",
            "title": "Kind",
            "type": "string"
          },
          "patch_digest": {
            "title": "Patch Digest",
            "type": "string"
          }
        },
        "required": [
          "patch_digest"
        ],
        "title": "PatchApplied",
        "type": "object"
      },
      "PlanReady": {
        "additionalProperties": false,
        "description": "A remediation plan has been proposed and is ready for execution.",
        "properties": {
          "kind": {
            "const": "plan_ready",
            "default": "plan_ready",
            "title": "Kind",
            "type": "string"
          },
          "plan_summary": {
            "title": "Plan Summary",
            "type": "string"
          }
        },
        "required": [
          "plan_summary"
        ],
        "title": "PlanReady",
        "type": "object"
      },
      "RemediationError": {
        "additionalProperties": false,
        "description": "Failure payload carried by :class:`RemediationFailed`. Same shape as\n:class:`RecipeError` but a distinct type \u2014 the discriminator + Pydantic\ncan't tell two structurally-identical models apart at the umbrella, but\nthe field annotation on the Failed variants is type-time enforced.",
        "properties": {
          "details": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Details"
          },
          "error_id": {
            "title": "Error Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "error_id",
          "message"
        ],
        "title": "RemediationError",
        "type": "object"
      }
    },
    "discriminator": {
      "mapping": {
        "awaiting_human_review": "#/$defs/AwaitingHumanReview",
        "completed": "#/$defs/Completed",
        "failed_unrecoverable": "#/$defs/FailedUnrecoverable",
        "gate_failed_retryable": "#/$defs/GateFailedRetryable",
        "needs_plan": "#/$defs/NeedsPlan",
        "patch_applied": "#/$defs/PatchApplied",
        "plan_ready": "#/$defs/PlanReady"
      },
      "propertyName": "kind"
    },
    "oneOf": [
      {
        "$ref": "#/$defs/NeedsPlan"
      },
      {
        "$ref": "#/$defs/PlanReady"
      },
      {
        "$ref": "#/$defs/PatchApplied"
      },
      {
        "$ref": "#/$defs/GateFailedRetryable"
      },
      {
        "$ref": "#/$defs/AwaitingHumanReview"
      },
      {
        "$ref": "#/$defs/Completed"
      },
      {
        "$ref": "#/$defs/FailedUnrecoverable"
      }
    ]
  },
  "legal_transitions": [
    "awaiting_human_review->completed",
    "awaiting_human_review->failed_unrecoverable",
    "awaiting_human_review->plan_ready",
    "gate_failed_retryable->awaiting_human_review",
    "gate_failed_retryable->failed_unrecoverable",
    "gate_failed_retryable->needs_plan",
    "needs_plan->plan_ready",
    "patch_applied->awaiting_human_review",
    "patch_applied->completed",
    "patch_applied->failed_unrecoverable",
    "patch_applied->gate_failed_retryable",
    "plan_ready->awaiting_human_review",
    "plan_ready->failed_unrecoverable",
    "plan_ready->patch_applied"
  ],
  "max_event_bytes": 65536,
  "protocol": {
    "digest": {
      "annotations": {
        "return": "SutDigest"
      },
      "is_coroutine_function": false,
      "signature": "(self) -> 'SutDigest'"
    },
    "run_case": {
      "annotations": {
        "request": "VulnRemediationCase",
        "return": "VulnRemediationResult"
      },
      "is_coroutine_function": true,
      "signature": "(self, request: 'VulnRemediationCase') -> 'VulnRemediationResult'"
    }
  },
  "result_schema": {
    "$defs": {
      "CostSummary": {
        "additionalProperties": false,
        "description": "Token + cassette-replay accounting summary.\n\nNo provider names, no model slugs \u2014 those would couple the harness to\nPhase-4 internals; the bench scorecard reports token cost per case, not\nper model.",
        "properties": {
          "cassette_replays": {
            "title": "Cassette Replays",
            "type": "integer"
          },
          "tokens_in": {
            "title": "Tokens In",
            "type": "integer"
          },
          "tokens_out": {
            "title": "Tokens Out",
            "type": "integer"
          }
        },
        "required": [
          "tokens_in",
          "tokens_out",
          "cassette_replays"
        ],
        "title": "CostSummary",
        "type": "object"
      },
      "EvidenceRef": {
        "additionalProperties": false,
        "description": "A relative-path reference into the per-run artifact directory.\n\nRejects at construction (AC-5):\n\n* Absolute paths (POSIX ``/...``, Windows drive ``C:\\...``).\n* ``..`` components anywhere in the path.\n* Null bytes (``\\x00``) and C0/DEL control chars.\n* Secret-shaped substrings \u2014 the canonical\n  :data:`codegenie.coordinator.validator.SECRET_FIELD_PATTERN` matched as\n  a *substring* (so ``foo /etc/passwd`` and ``GITHUB_TOKEN=ghp_...``\n  both die before they reach the harness).\n* Cleartext secrets matching any of the Phase-2 sanitizer's\n  ``_PATTERNS`` (AWS / GitHub / JWT / RSA / npm / Anthropic).",
        "properties": {
          "ref": {
            "title": "Ref",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "title": "EvidenceRef",
        "type": "object"
      },
      "GateSummary": {
        "additionalProperties": false,
        "description": "Summarised Phase-5 gate outcome the harness consumes.\n\n*Not* the full gate transcript \u2014 that lives in the per-run artifact\ndirectory referenced by ``VulnRemediationResult.evidence_references``.",
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "last_outcome": {
            "enum": [
              "pass",
              "fail_retryable",
              "fail_terminal",
              "not_run"
            ],
            "title": "Last Outcome",
            "type": "string"
          }
        },
        "required": [
          "attempts",
          "last_outcome"
        ],
        "title": "GateSummary",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Frozen Pydantic model \u2014 sanitization-enforcing harness output.",
    "properties": {
      "case_id": {
        "title": "Case Id",
        "type": "string"
      },
      "cost_summary": {
        "$ref": "#/$defs/CostSummary"
      },
      "evidence_references": {
        "items": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "title": "Evidence References",
        "type": "array"
      },
      "failure_modes": {
        "items": {
          "type": "string"
        },
        "title": "Failure Modes",
        "type": "array"
      },
      "gate_summary": {
        "$ref": "#/$defs/GateSummary"
      },
      "patch_digest": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Patch Digest"
      },
      "sut_digest": {
        "title": "Sut Digest",
        "type": "string"
      },
      "terminal_state": {
        "enum": [
          "completed",
          "awaiting_human_review",
          "failed_unrecoverable"
        ],
        "title": "Terminal State",
        "type": "string"
      }
    },
    "required": [
      "case_id",
      "terminal_state",
      "patch_digest",
      "gate_summary",
      "failure_modes",
      "cost_summary",
      "evidence_references",
      "sut_digest"
    ],
    "title": "VulnRemediationResult",
    "type": "object"
  },
  "semantic_boundary_kinds": [
    "awaiting_human_review",
    "completed",
    "failed_unrecoverable",
    "gate_failed_retryable",
    "patch_applied",
    "plan_ready"
  ],
  "transition_event_schema": {
    "$defs": {
      "JsonValue": {}
    },
    "additionalProperties": false,
    "description": "A single transition record \u2014 chained for replay-determinism (ADR-0003).\n\n``triggering_outcome`` is a :data:`~pydantic.JsonValue` rather than a\ndiscriminated union of ``RecipeOutcome | NodeTransition | TrustOutcome``:\nthe substrate doesn't need to dispatch on the upstream typed shape \u2014\nonly to serialise it deterministically into the chain-head computation.\nThe producer (Phase-6 S3-01 subgraph nodes) serialises via\n``outcome.model_dump(mode='json')`` before constructing this event.\nSee module docstring for the rationale (deferred coupling to\n``codegenie.plugins.subgraph``).",
    "properties": {
      "chain_head": {
        "title": "Chain Head",
        "type": "string"
      },
      "evidence_digest": {
        "title": "Evidence Digest",
        "type": "string"
      },
      "next_state_id": {
        "enum": [
          "needs_plan",
          "plan_ready",
          "patch_applied",
          "gate_failed_retryable",
          "awaiting_human_review",
          "completed",
          "failed_unrecoverable"
        ],
        "title": "Next State Id",
        "type": "string"
      },
      "prior_state_id": {
        "enum": [
          "needs_plan",
          "plan_ready",
          "patch_applied",
          "gate_failed_retryable",
          "awaiting_human_review",
          "completed",
          "failed_unrecoverable"
        ],
        "title": "Prior State Id",
        "type": "string"
      },
      "transition_id": {
        "title": "Transition Id",
        "type": "string"
      },
      "triggering_outcome": {
        "$ref": "#/$defs/JsonValue"
      },
      "workflow_id": {
        "title": "Workflow Id",
        "type": "string"
      }
    },
    "required": [
      "transition_id",
      "prior_state_id",
      "next_state_id",
      "triggering_outcome",
      "evidence_digest",
      "chain_head",
      "workflow_id"
    ],
    "title": "TransitionEvent",
    "type": "object"
  }
}
