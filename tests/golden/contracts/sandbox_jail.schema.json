{
  "spec": {
    "$defs": {
      "DenyAll": {
        "additionalProperties": false,
        "description": "No egress permitted. Default-deny baseline for ``npm test`` /\ndeterministic recipes that should not need any network.",
        "properties": {
          "kind": {
            "const": "deny_all",
            "default": "deny_all",
            "title": "Kind",
            "type": "string"
          }
        },
        "title": "DenyAll",
        "type": "object"
      },
      "GitEnv": {
        "additionalProperties": false,
        "description": "Typed env for git invocations inside the jail (ADR-0006 cross-ref to\nS6-04 ``LocalGitOps``). Disables terminal prompts + askpass leakage.",
        "properties": {
          "kind": {
            "const": "git",
            "default": "git",
            "title": "Kind",
            "type": "string"
          }
        },
        "title": "GitEnv",
        "type": "object"
      },
      "NpmEnv": {
        "additionalProperties": false,
        "description": "Typed env for npm invocations inside the jail (ADR-0006 \u00a7Decision).\n\n``to_env_mapping`` ALWAYS emits ``npm_config_ignore_scripts=\"true\"`` \u2014\nthe env half of the ``--ignore-scripts`` split defence. The CLI half\n(``--ignore-scripts`` in ``cmd``) lives at the consumer; S4-05's\ncapability-fence test ties them together.",
        "properties": {
          "kind": {
            "const": "npm",
            "default": "npm",
            "title": "Kind",
            "type": "string"
          }
        },
        "title": "NpmEnv",
        "type": "object"
      },
      "RegistryAllowlist": {
        "additionalProperties": false,
        "description": "Egress permitted only to the listed hosts. Each host must be a strict\n``https://`` URL; empty allowlists are rejected (use :class:`DenyAll`\ninstead \u2014 the empty allowlist is meaningless and a likely bug).",
        "properties": {
          "kind": {
            "const": "registry_allowlist",
            "default": "registry_allowlist",
            "title": "Kind",
            "type": "string"
          },
          "hosts": {
            "items": {
              "type": "string"
            },
            "title": "Hosts",
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "hosts"
        ],
        "title": "RegistryAllowlist",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Frozen value type describing a single jailed subprocess invocation.\n\nEvery field carries a smart-constructor bound at the type level. The\nspec is *immutable* \u2014 adapters cannot mutate the spec they were handed,\neliminating a class of \"log says X, sandbox ran Y\" forensic failures.",
    "properties": {
      "cmd": {
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Cmd",
        "type": "array"
      },
      "cwd": {
        "format": "path",
        "title": "Cwd",
        "type": "string"
      },
      "env": {
        "discriminator": {
          "mapping": {
            "git": "#/$defs/GitEnv",
            "npm": "#/$defs/NpmEnv"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/NpmEnv"
          },
          {
            "$ref": "#/$defs/GitEnv"
          }
        ],
        "title": "Env"
      },
      "network": {
        "discriminator": {
          "mapping": {
            "deny_all": "#/$defs/DenyAll",
            "registry_allowlist": "#/$defs/RegistryAllowlist"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/DenyAll"
          },
          {
            "$ref": "#/$defs/RegistryAllowlist"
          }
        ],
        "title": "Network"
      },
      "time_budget_s": {
        "exclusiveMinimum": 0,
        "title": "Time Budget S",
        "type": "number"
      },
      "memory_mib": {
        "minimum": 1,
        "title": "Memory Mib",
        "type": "integer"
      },
      "pids_max": {
        "minimum": 1,
        "title": "Pids Max",
        "type": "integer"
      }
    },
    "required": [
      "cmd",
      "cwd",
      "env",
      "network",
      "time_budget_s",
      "memory_mib",
      "pids_max"
    ],
    "title": "JailedSubprocessSpec",
    "type": "object"
  },
  "result": {
    "$defs": {
      "Completed": {
        "additionalProperties": false,
        "description": "Process exited cleanly (or with a non-zero exit code that is still a\nwell-formed exit). Carries byte *sizes*, not byte contents \u2014 the\nadapter redirects full content to a ``SandboxedPath``-rooted log file\noutside this envelope to avoid leaking secrets through ``RepoContext``.",
        "properties": {
          "kind": {
            "const": "completed",
            "default": "completed",
            "title": "Kind",
            "type": "string"
          },
          "exit_code": {
            "title": "Exit Code",
            "type": "integer"
          },
          "stdout_bytes": {
            "minimum": 0,
            "title": "Stdout Bytes",
            "type": "integer"
          },
          "stderr_bytes": {
            "minimum": 0,
            "title": "Stderr Bytes",
            "type": "integer"
          },
          "wall_time_s": {
            "minimum": 0,
            "title": "Wall Time S",
            "type": "number"
          }
        },
        "required": [
          "exit_code",
          "stdout_bytes",
          "stderr_bytes",
          "wall_time_s"
        ],
        "title": "Completed",
        "type": "object"
      },
      "DiskQuotaExceeded": {
        "additionalProperties": false,
        "description": "Adapter aborted the process for writing more bytes than the jail's\ntmpfs / quota permits.",
        "properties": {
          "kind": {
            "const": "disk_quota_exceeded",
            "default": "disk_quota_exceeded",
            "title": "Kind",
            "type": "string"
          },
          "quota_bytes": {
            "minimum": 0,
            "title": "Quota Bytes",
            "type": "integer"
          },
          "bytes_written": {
            "minimum": 0,
            "title": "Bytes Written",
            "type": "integer"
          }
        },
        "required": [
          "quota_bytes",
          "bytes_written"
        ],
        "title": "DiskQuotaExceeded",
        "type": "object"
      },
      "JailSetupFailed": {
        "additionalProperties": false,
        "description": "Adapter could not stand up the jail (binary missing from the\nallowlist, ``bwrap`` not on PATH, ``CAP_NET_ADMIN`` absent, ``cwd``\nmissing, generic kernel setup failure). Distinct from a clean\n:class:`Completed` because the child never actually ran.\n\nThe :attr:`reason` field is a closed enum of short tokens; :attr:`detail`\nis a redacted human-readable message preserved verbatim from the\nunderlying exception (no absolute paths; no secrets \u2014 Pydantic's\n``extra=\"forbid\"`` plus the sanitizer fences cover the redaction\ncontract).",
        "properties": {
          "kind": {
            "const": "jail_setup_failed",
            "default": "jail_setup_failed",
            "title": "Kind",
            "type": "string"
          },
          "reason": {
            "enum": [
              "binary-not-allowlisted",
              "bwrap-not-on-path",
              "cwd-missing",
              "cap-net-admin-missing",
              "kernel-setup-failed"
            ],
            "title": "Reason",
            "type": "string"
          },
          "detail": {
            "minLength": 1,
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "reason",
          "detail"
        ],
        "title": "JailSetupFailed",
        "type": "object"
      },
      "NetworkDenied": {
        "additionalProperties": false,
        "description": "Adapter blocked egress to a non-allowlisted host. ``host`` is\nobservable per ADR-0006 \u00a7Decision so the operator can debug a\n``.npmrc`` redirect (Edge case E7).",
        "properties": {
          "kind": {
            "const": "network_denied",
            "default": "network_denied",
            "title": "Kind",
            "type": "string"
          },
          "host": {
            "minLength": 1,
            "title": "Host",
            "type": "string"
          }
        },
        "required": [
          "host"
        ],
        "title": "NetworkDenied",
        "type": "object"
      },
      "OomKilled": {
        "additionalProperties": false,
        "description": "Kernel / cgroup killed the process for exceeding ``memory_mib``.",
        "properties": {
          "kind": {
            "const": "oom_killed",
            "default": "oom_killed",
            "title": "Kind",
            "type": "string"
          },
          "peak_rss_mib": {
            "minimum": 0,
            "title": "Peak Rss Mib",
            "type": "integer"
          }
        },
        "required": [
          "peak_rss_mib"
        ],
        "title": "OomKilled",
        "type": "object"
      },
      "TimedOut": {
        "additionalProperties": false,
        "description": "Adapter killed the process after ``budget_s`` elapsed.",
        "properties": {
          "kind": {
            "const": "timed_out",
            "default": "timed_out",
            "title": "Kind",
            "type": "string"
          },
          "budget_s": {
            "exclusiveMinimum": 0,
            "title": "Budget S",
            "type": "number"
          },
          "elapsed_s": {
            "exclusiveMinimum": 0,
            "title": "Elapsed S",
            "type": "number"
          }
        },
        "required": [
          "budget_s",
          "elapsed_s"
        ],
        "title": "TimedOut",
        "type": "object"
      }
    },
    "discriminator": {
      "mapping": {
        "completed": "#/$defs/Completed",
        "disk_quota_exceeded": "#/$defs/DiskQuotaExceeded",
        "jail_setup_failed": "#/$defs/JailSetupFailed",
        "network_denied": "#/$defs/NetworkDenied",
        "oom_killed": "#/$defs/OomKilled",
        "timed_out": "#/$defs/TimedOut"
      },
      "propertyName": "kind"
    },
    "oneOf": [
      {
        "$ref": "#/$defs/Completed"
      },
      {
        "$ref": "#/$defs/TimedOut"
      },
      {
        "$ref": "#/$defs/OomKilled"
      },
      {
        "$ref": "#/$defs/NetworkDenied"
      },
      {
        "$ref": "#/$defs/DiskQuotaExceeded"
      },
      {
        "$ref": "#/$defs/JailSetupFailed"
      }
    ]
  }
}
